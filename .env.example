# Copy to your hosting provider's environment settings; do not commit real secrets.
NODE_ENV=production
PORT=3000
DATA_DIR=/var/data
TRUST_PROXY=1
ADMIN_USERNAME=admin
# Generate with: node -e "require('bcryptjs').hash('YOUR_LONG_UNIQUE_PASSWORD', 12).then(console.log)"
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
